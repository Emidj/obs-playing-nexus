# Audit override; the actual Twitch CMake project and sources remain unchanged.
if(NOT IS_DIRECTORY "${PLAYING_GROUP_CANDIDATE}")
  message(FATAL_ERROR "Explicit shared group candidate directory required")
endif()
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
# Some upstream sources include the renderer by ../adapters rather than from
# an include directory. A work-only source tree avoids mixing class definitions.
# This copy is strictly an audit build and is never a Playing source dependency.
file(COPY "${CMAKE_SOURCE_DIR}/src" DESTINATION "${CMAKE_BINARY_DIR}/candidate-source")
configure_file("${PLAYING_GROUP_CANDIDATE}/obs-visual-renderer.hpp" "${CMAKE_BINARY_DIR}/candidate-source/src/adapters/obs-visual-renderer.hpp" COPYONLY)
configure_file("${PLAYING_GROUP_CANDIDATE}/obs-visual-renderer.cpp" "${CMAKE_BINARY_DIR}/candidate-source/src/adapters/obs-visual-renderer.cpp" COPYONLY)
function(playing_apply_group_candidate)
  get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
  set(changed "")
  foreach(target IN LISTS targets)
    get_target_property(kind "${target}" TYPE)
    if(kind STREQUAL "UTILITY" OR kind STREQUAL "INTERFACE_LIBRARY")
      continue()
    endif()
    target_include_directories("${target}" BEFORE PRIVATE "${CMAKE_BINARY_DIR}/candidate-source/src" "${CMAKE_BINARY_DIR}/candidate-source/src/adapters")
    get_target_property(sources "${target}" SOURCES)
    if(NOT sources)
      continue()
    endif()
    set(updated "")
    foreach(source IN LISTS sources)
      if(source MATCHES "^src/")
        list(APPEND updated "${CMAKE_BINARY_DIR}/candidate-source/${source}")
        if(source STREQUAL "src/adapters/obs-visual-renderer.cpp")
          list(APPEND changed "${target}")
        endif()
      elseif(source MATCHES "(^|/)src/adapters/obs-visual-renderer[.]cpp$")
        list(APPEND updated "${CMAKE_BINARY_DIR}/candidate-source/src/adapters/obs-visual-renderer.cpp")
        list(APPEND changed "${target}")
      else()
        list(APPEND updated "${source}")
      endif()
    endforeach()
    set_property(TARGET "${target}" PROPERTY SOURCES "${updated}")
  endforeach()
  if(NOT changed)
    message(FATAL_ERROR "No renderer consumers replaced in isolated candidate build")
  endif()
  file(WRITE "${CMAKE_BINARY_DIR}/candidate-targets.txt" "${changed}\n")
endfunction()
cmake_language(DEFER CALL playing_apply_group_candidate)
